CKB_NETWORK=testnet

# CKB RPC (optional: defaults to the public testnet node)
CKB_RPC_URL=

# Issuer / lender wallet (0x-prefixed secp256k1 key). Deploys the contracts,
# writes the KYC attestation, owns the loan token, signs as the vault.
PRIVATE_KEY=

# Borrower wallet (a separate funded key). Owns the RWA asset and repays.
BORROWER_PRIVATE_KEY=

# KYC attestation (mocked for this phase). Defaults to the borrower's address
# when empty.
KYC_MOCK_PASS_ADDRESS=

# Lending configuration (amounts are loan-token base units; no decimals)
LENDING_BORROW_AMOUNT=
LENDING_REPAY_AMOUNT=
LENDING_TERM_SECONDS=
